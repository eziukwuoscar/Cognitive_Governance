{
  "policies": [
    {
      "policy_id": "POL-007",
      "name": "Deal Valuation Change Policy",
      "description": "Material changes to deal valuations require senior approval.",

      "applies_to": {
        "identity_types": ["human", "agent"],
        "actions": ["deal.update"]
      },

      "conditions": {
        "valuation_change_percent_gt": 20
      },

      "effect": "require_approval",

      "approval": {
        "required_role": "Managing Director"
      }
    },
